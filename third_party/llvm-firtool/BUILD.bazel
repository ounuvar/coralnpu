exports_files(glob([
    "org.chipsalliance/llvm-firtool/linux-x64/bin/**",
    "org.chipsalliance/llvm-firtool/macos-x64/bin/**",
]))

package(default_visibility = ["//visibility:public"])

sh_binary(
    name = "firtool",
    srcs = [":firtool.sh"],
    # CIRCT publishes no Apple Silicon build; the x86_64 macOS binary runs
    # under Rosetta 2.
    data = select({
        "@platforms//os:macos": [
            "@llvm_firtool//:org.chipsalliance/llvm-firtool/macos-x64/bin/firtool",
        ],
        "//conditions:default": [
            "@llvm_firtool//:org.chipsalliance/llvm-firtool/linux-x64/bin/firtool",
        ],
    }),
)
