+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "sim/coralnpu_v2_requant_instructions.h"
+
+#include <cstdint>
+
+#include "riscv/riscv_state.h"
+#include "riscv/riscv_vector_instruction_helpers.h"
+#include "riscv/riscv_vector_state.h"
+#include "mpact/sim/generic/instruction.h"
+
+namespace coralnpu::sim {
+
+using ::mpact::sim::generic::Instruction;
+using ::mpact::sim::riscv::RiscVBinaryVectorOp;
+using ::mpact::sim::riscv::RiscVState;
+using ::mpact::sim::riscv::RiscVTernaryVectorOp;
+
+namespace {
+
+int32_t Requant(int32_t acc, int32_t multiplier, int32_t shift) {
+  const int32_t sh = shift < -31 ? -31 : (shift > 31 ? 31 : shift);
+  const int32_t x =
+      static_cast<int32_t>(static_cast<uint32_t>(acc) << (sh > 0 ? sh : 0));
+  int32_t y =
+      (x == INT32_MIN && multiplier == INT32_MIN)
+          ? INT32_MAX
+          : static_cast<int32_t>(
+                (static_cast<int64_t>(x) * multiplier + (int64_t{1} << 30)) >>
+                31);
+  const int e = sh > 0 ? 0 : -sh;
+  if (e != 0) {
+    const int32_t mask = static_cast<int32_t>((int64_t{1} << e) - 1);
+    const int32_t threshold = (mask >> 1) + (y < 0 ? 1 : 0);
+    y = (y >> e) + ((y & mask) > threshold ? 1 : 0);
+  }
+  return y;
+}
+
+int32_t Clamp(int32_t value, uint32_t packed) {
+  const int32_t offset = static_cast<int16_t>(packed & 0xffff);
+  const int32_t lo = static_cast<int8_t>((packed >> 16) & 0xff);
+  const int32_t hi = static_cast<int8_t>((packed >> 24) & 0xff);
+  int32_t y = static_cast<int32_t>(static_cast<uint32_t>(value) +
+                                   static_cast<uint32_t>(offset));
+  y = y < lo ? lo : y;
+  return y > hi ? hi : y;
+}
+
+}  // namespace
+
+void CoralNPUV2Vrequant(const Instruction* inst) {
+  auto* rv_vector = static_cast<RiscVState*>(inst->state())->rv_vector();
+  if (rv_vector->selected_element_width() != 4) {
+    rv_vector->set_vector_exception();
+    return;
+  }
+  RiscVTernaryVectorOp<int32_t, int32_t, int32_t>(
+      rv_vector, inst, [](int32_t vs2, int32_t vs1, int32_t vd) -> int32_t {
+        return Requant(vd, vs2, vs1);
+      });
+}
+
+void CoralNPUV2Vrqclamp(const Instruction* inst) {
+  auto* rv_vector = static_cast<RiscVState*>(inst->state())->rv_vector();
+  if (rv_vector->selected_element_width() != 4) {
+    rv_vector->set_vector_exception();
+    return;
+  }
+  RiscVBinaryVectorOp<int32_t, int32_t, uint32_t>(
+      rv_vector, inst,
+      [](int32_t vs2, uint32_t rs1) -> int32_t { return Clamp(vs2, rs1); });
+}
+
+}  // namespace coralnpu::sim
