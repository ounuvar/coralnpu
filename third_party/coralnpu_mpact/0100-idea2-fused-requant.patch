+#ifndef SIM_CORALNPU_V2_REQUANT_INSTRUCTIONS_H_
+#define SIM_CORALNPU_V2_REQUANT_INSTRUCTIONS_H_
+
+#include "mpact/sim/generic/instruction.h"
+
+namespace coralnpu::sim {
+
+// Fused requantization, CoralNPU idea 2 (ounuvar/coralnpu#9). Both need
+// SEW=32. Golden model: sw/opt/litert-micro/requant_ref.h in coralnpu.
+
+// vrequant.vv vd, vs2, vs1: vd[i] = MultiplyByQuantizedMultiplier(vd[i],
+// vs2[i], vs1[i]) with TFLite's double rounding.
+void CoralNPUV2Vrequant(const mpact::sim::generic::Instruction* inst);
+
+// vrqclamp.vx vd, vs2, rs1: rs1 = {hi[31:24], lo[23:16], offset[15:0]};
+// vd[i] = min(max(vs2[i] + offset, lo), hi).
+void CoralNPUV2Vrqclamp(const mpact::sim::generic::Instruction* inst);
+
+}  // namespace coralnpu::sim
+
+#endif  // SIM_CORALNPU_V2_REQUANT_INSTRUCTIONS_H_
