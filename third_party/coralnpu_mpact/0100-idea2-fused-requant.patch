From 94c5c370b57cbc50702c9c11f29a859e7d194409 Mon Sep 17 00:00:00 2001
From: aayushmerchant <akm4397@eid.utexas.edu>
Date: Tue, 3 Nov 2026 14:13:46 -0600
Subject: [PATCH] Add CoralNPU fused requantization instructions (vrequant.vv,
 vrqclamp.vx)

Idea 2 (#9) in ounuvar/coralnpu: decoder entries in coralnpu_v2.bin_fmt and coralnpu_v2.isa, semantics in coralnpu_v2_requant_instructions.cc. Both need SEW=32.
---
 sim/BUILD                               | 13 ++++
 sim/coralnpu_v2.bin_fmt                 |  3 +
 sim/coralnpu_v2.isa                     |  8 +++
 sim/coralnpu_v2_requant_instructions.cc | 87 +++++++++++++++++++++++++
 sim/coralnpu_v2_requant_instructions.h  | 35 ++++++++++
 5 files changed, 146 insertions(+)
 create mode 100644 sim/coralnpu_v2_requant_instructions.cc
 create mode 100644 sim/coralnpu_v2_requant_instructions.h

diff --git a/sim/BUILD b/sim/BUILD
index 270fed4..f4df0b2 100755
--- a/sim/BUILD
+++ b/sim/BUILD
@@ -254,6 +254,18 @@ cc_library(
     ],
 )
 
+cc_library(
+    name = "coralnpu_v2_requant_instructions",
+    srcs = ["coralnpu_v2_requant_instructions.cc"],
+    hdrs = ["coralnpu_v2_requant_instructions.h"],
+    copts = ["-O3"],
+    deps = [
+        "@com_google_mpact-riscv//riscv:riscv_state",
+        "@com_google_mpact-riscv//riscv:riscv_v",
+        "@mpact-sim//mpact/sim/generic:instruction",
+    ],
+)
+
 mpact_isa_decoder(
     name = "coralnpu_v2_isa",
     src = "coralnpu_v2.isa",
@@ -265,6 +277,7 @@ mpact_isa_decoder(
     isa_name = "CoralNPUV2",
     deps = [
         ":coralnpu_v2_instructions",
+        ":coralnpu_v2_requant_instructions",
         "@abseil-cpp//absl/functional:bind_front",
         "@com_google_mpact-riscv//riscv:riscv_bitmanip_instructions",
         "@com_google_mpact-riscv//riscv:riscv_g",
diff --git a/sim/coralnpu_v2.bin_fmt b/sim/coralnpu_v2.bin_fmt
index 4a06c65..244bbe4 100755
--- a/sim/coralnpu_v2.bin_fmt
+++ b/sim/coralnpu_v2.bin_fmt
@@ -716,6 +716,9 @@ instruction group RiscVZve32xInst32[32] : Inst32Format {
   vmadd_vx    : VArith : func6 == 0b101'001, func3 == 0b110, opcode == 0b101'0111;
   vnmsub_vv   : VArith : func6 == 0b101'011, func3 == 0b010, opcode == 0b101'0111;
   vnmsub_vx   : VArith : func6 == 0b101'011, func3 == 0b110, opcode == 0b101'0111;
+  // CoralNPU fused requantization, idea 2 (#9).
+  vrequant_vv : VArith : func6 == 0b010'011, func3 == 0b010, opcode == 0b101'0111;
+  vrqclamp_vx : VArith : func6 == 0b010'001, func3 == 0b110, opcode == 0b101'0111;
   vmacc_vv    : VArith : func6 == 0b101'101, func3 == 0b010, opcode == 0b101'0111;
   vmacc_vx    : VArith : func6 == 0b101'101, func3 == 0b110, opcode == 0b101'0111;
   vnmsac_vv   : VArith : func6 == 0b101'111, func3 == 0b010, opcode == 0b101'0111;
diff --git a/sim/coralnpu_v2.isa b/sim/coralnpu_v2.isa
index 70d4471..0b3de8a 100755
--- a/sim/coralnpu_v2.isa
+++ b/sim/coralnpu_v2.isa
@@ -750,6 +750,7 @@ slot riscv_zve32x {
     #include "riscv/riscv_vector_reduction_instructions.h"
     #include "riscv/riscv_vector_unary_instructions.h"
     #include "absl/functional/bind_front.h"
+    #include "sim/coralnpu_v2_requant_instructions.h"
   }
   default size = 4;
   default latency = 0;
@@ -1584,6 +1585,13 @@ slot riscv_zve32x {
     vnmsub_vx{: vs2, rs1, vd, vmask: vd},
       disasm: "vnmsub.vx", "%vd, %vs2, %rs1, %vmask",
       semfunc: "&::mpact::sim::riscv::Vnmsub";
+    // CoralNPU fused requantization, idea 2 (#9).
+    vrequant_vv{: vs2, vs1, vd, vmask: vd},
+      disasm: "vrequant.vv", "%vd, %vs2, %vs1, %vmask",
+      semfunc: "&::coralnpu::sim::CoralNPUV2Vrequant";
+    vrqclamp_vx{: vs2, rs1, vmask : vd},
+      disasm: "vrqclamp.vx", "%vd, %vs2, %rs1, %vmask",
+      semfunc: "&::coralnpu::sim::CoralNPUV2Vrqclamp";
     vmacc_vv{: vs2, vs1, vd, vmask: vd},
       disasm: "vmacc.vv", "%vd, %vs2, %vs1, %vmask",
       semfunc: "&::mpact::sim::riscv::Vmacc";
diff --git a/sim/coralnpu_v2_requant_instructions.cc b/sim/coralnpu_v2_requant_instructions.cc
new file mode 100644
index 0000000..089aaa9
--- /dev/null
+++ b/sim/coralnpu_v2_requant_instructions.cc
@@ -0,0 +1,87 @@
