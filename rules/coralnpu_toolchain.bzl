"""Repository rule providing the CoralNPU V2 RISC-V cross toolchain.

On x86_64 Linux this downloads Google's prebuilt toolchain archive. On an
Apple Silicon Mac it links to a locally installed riscv-gnu-toolchain instead
(by default the Homebrew `riscv-software-src/riscv/riscv-gnu-toolchain`
formula). Set CORALNPU_RISCV_TOOLCHAIN to the install prefix to use a
different local toolchain on any host.

The resulting repository has the same layout either way (bin/,
lib/gcc/riscv64-unknown-elf/<ver>/, riscv64-unknown-elf/include, ...), so
toolchain/wrappers and toolchain/cc_toolchain_config.bzl work unchanged.
"""

_BUILD_FILE = """
licenses(["notice"])
exports_files(glob(["**"]))
package(default_visibility = ["//visibility:public"])
filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)
"""

_HOMEBREW_PREFIXES = [
    "/opt/homebrew/opt/riscv-gnu-toolchain",
    "/usr/local/opt/riscv-gnu-toolchain",
]

_GCC = "bin/riscv64-unknown-elf-gcc"

def _find_local_toolchain(rctx):
    """Returns the local toolchain prefix to use, or None to download."""
    override = rctx.getenv("CORALNPU_RISCV_TOOLCHAIN", "")
    if override:
        if not rctx.path(override + "/" + _GCC).exists:
            fail("CORALNPU_RISCV_TOOLCHAIN={} does not contain {}".format(override, _GCC))
        return override

    os = rctx.os.name.lower()
    arch = rctx.os.arch.lower()
    if not ("mac" in os and arch in ("aarch64", "arm64")):
        return None

    brew = rctx.which("brew")
    candidates = []
    if brew:
        res = rctx.execute([brew, "--prefix", "riscv-gnu-toolchain"])
        if res.return_code == 0 and res.stdout.strip():
            candidates.append(res.stdout.strip())
    candidates.extend(_HOMEBREW_PREFIXES)
    for prefix in candidates:
        if rctx.path(prefix + "/" + _GCC).exists:
            return prefix
    fail("""No RISC-V toolchain found for Apple Silicon. Install one with:
  brew tap riscv-software-src/riscv
  brew trust --formula riscv-software-src/riscv/riscv-gnu-toolchain
  brew install riscv-software-src/riscv/riscv-gnu-toolchain
or set CORALNPU_RISCV_TOOLCHAIN to an install prefix containing {}.""".format(_GCC))

def _coralnpu_toolchain_repo_impl(rctx):
    prefix = _find_local_toolchain(rctx)
    builtin_include_dirs = []
    htif_search_dir = ""
    if prefix == None:
        rctx.download_and_extract(
            url = rctx.attr.urls,
            sha256 = rctx.attr.sha256,
            stripPrefix = rctx.attr.strip_prefix,
        )
    else:
        # Resolve Homebrew's opt/ symlink so the repo pins a concrete Cellar
        # path, and link each top-level entry into the repository.
        root = rctx.path(prefix).realpath
        for entry in root.readdir():
            if entry.basename in ("BUILD", "BUILD.bazel", "WORKSPACE", "MODULE.bazel"):
                continue
            rctx.symlink(entry, entry.basename)
        rctx.watch(root.get_child(_GCC))

        # GCC reports headers reached through the symlinks by their real
        # absolute path; declare it so Bazel's include check accepts them.
        builtin_include_dirs.append(str(root))

        # Semihosting links use --specs=htif_nano.specs (and its htif.ld),
        # which Google's toolchain gets from libgloss-htif. Both are static
        # files, and the HTIF syscalls themselves come from
        # //toolchain/crt:crt_semihosting, so nothing needs compiling: fetch
        # the pinned sources and keep just util/.
        if not root.get_child("riscv64-unknown-elf/lib/htif_nano.specs").exists:
            rctx.download_and_extract(
                url = rctx.attr.htif_urls,
                sha256 = rctx.attr.htif_sha256,
                stripPrefix = rctx.attr.htif_strip_prefix,
                output = "_libgloss_htif",
            )
            for f in rctx.path("_libgloss_htif/util").readdir():
                if f.basename.endswith(".specs") or f.basename.endswith(".ld"):
                    rctx.file("htif/" + f.basename, rctx.read(f))
            rctx.file("htif/LICENSE", rctx.read("_libgloss_htif/LICENSE"))
            rctx.delete("_libgloss_htif")
            htif_search_dir = "htif"
    rctx.file("BUILD.bazel", _BUILD_FILE)
    rctx.file(
        "defs.bzl",
        ("\"\"\"Generated by coralnpu_toolchain_repo.\"\"\"\n\n" +
         "BUILTIN_INCLUDE_DIRECTORIES = {}\n" +
         "# Repo-relative dir with htif_nano.specs/htif.ld, or \"\" if bundled.\n" +
         "HTIF_SEARCH_DIR = {}\n").format(
            repr(builtin_include_dirs),
            repr(htif_search_dir),
        ),
    )

coralnpu_toolchain_repo = repository_rule(
    implementation = _coralnpu_toolchain_repo_impl,
    attrs = {
        "urls": attr.string_list(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(),
        "htif_urls": attr.string_list(),
        "htif_sha256": attr.string(),
        "htif_strip_prefix": attr.string(),
    },
    environ = ["CORALNPU_RISCV_TOOLCHAIN"],
)
