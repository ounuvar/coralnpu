# AWS HDK synthesis script for the CoralNPU CL, called by aws_build_dcp_from_cl.py as
# synth_${CL}.tcl (see fpga/f2/README.md). Based on the HDK's CL_TEMPLATE synth script.
#
# The HDK template reads every file in design/ in glob order. The SoC has several hundred files
# with packages and include paths, so instead this script reads the ordered list that
# export_cl_coralnpu.py generated from the FuseSoC project (cl_coralnpu_sources.tcl: sources,
# include directories, defines and top-level parameters), then the CL top from design/.

source ${HDK_SHELL_DIR}/build/scripts/synth_cl_header.tcl

print "Reading CoralNPU sources (generated by export_cl_coralnpu.py)"
# Sets coralnpu_sources, coralnpu_include_dirs, coralnpu_defines and coralnpu_generics.
source ${CL_DIR}/build/scripts/cl_coralnpu_sources.tcl
read_verilog -sv $coralnpu_sources
read_verilog -sv [list \
  ${src_post_enc_dir}/cl_coralnpu.sv \
]

print "Reading user constraints"
read_xdc [list \
  ${constraints_dir}/cl_synth_user.xdc \
  ${constraints_dir}/cl_timing_user.xdc \
]
set_property PROCESSING_ORDER LATE [get_files cl_synth_user.xdc]
set_property PROCESSING_ORDER LATE [get_files cl_timing_user.xdc]

print "Starting synthesizing customer design ${CL}"
update_compile_order -fileset sources_1
synth_design -mode out_of_context \
             -top ${CL} \
             -verilog_define [concat XSDB_SLV_DIS $coralnpu_defines] \
             -include_dirs [concat ${src_post_enc_dir} $coralnpu_include_dirs] \
             -generic $coralnpu_generics \
             -part ${DEVICE_TYPE} \
             -keep_equivalent_registers

print "Connecting debug network"
source ${HDK_SHELL_DIR}/build/scripts/synth_cl_footer.tcl
